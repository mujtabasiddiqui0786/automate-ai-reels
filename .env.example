# Server Configuration
PORT=3000
HOST=0.0.0.0

# Static File Serving
# Base URL where videos will be accessible (must be HTTPS for Instagram)
# For local development, use http://localhost:3000
# For production, use your actual domain with HTTPS
STATIC_BASE_URL=http://localhost:3000

# File Paths (optional, defaults to project directories)
BASE_VIDEO_DIR=./assets/base_loops
OUTPUT_VIDEO_DIR=./videos/output

# YouTube Data API v3 Credentials
# Get these from: https://console.cloud.google.com/apis/credentials
# You'll need to create OAuth 2.0 credentials and get a refresh token
YOUTUBE_CLIENT_ID=your_youtube_client_id_here
YOUTUBE_CLIENT_SECRET=your_youtube_client_secret_here
YOUTUBE_REFRESH_TOKEN=your_youtube_refresh_token_here

# Instagram Graph API Credentials
# Get these from: https://developers.facebook.com/apps/
# You'll need to create a Facebook App and get Instagram Business Account access
IG_APP_ID=your_instagram_app_id_here
IG_APP_SECRET=your_instagram_app_secret_here
IG_ACCESS_TOKEN=your_instagram_access_token_here
IG_USER_ID=your_instagram_user_id_here

# TikTok Posting API Credentials (optional)
# Get these from: https://developers.tiktok.com/
# If not configured, videos will be exported to exports/tiktok/ directory
TIKTOK_CLIENT_KEY=your_tiktok_client_key_here
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret_here
TIKTOK_ACCESS_TOKEN=your_tiktok_access_token_here
